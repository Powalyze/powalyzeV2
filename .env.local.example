# ====================================================================
# POWALYZE - CONFIGURATION ENVIRONNEMENT
# ====================================================================

# ========================================
# SUPABASE (Obligatoire pour mode PROD)
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# ========================================
# STRIPE (Obligatoire pour paiements)
# ========================================
STRIPE_SECRET_KEY=sk_test_xxx (ou sk_live_xxx en production)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Price IDs Stripe
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=price_yyy
STRIPE_PRICE_ENTERPRISE=price_zzz

# ========================================
# AUTHENTIFICATION
# ========================================
JWT_SECRET=change-in-production
NEXTAUTH_SECRET=change-in-production
NEXTAUTH_URL=http://localhost:3000

# ========================================
# OPENAI / AZURE OPENAI (Optionnel)
# ========================================
OPENAI_API_KEY=sk-xxx

# OU Azure OpenAI:
AZURE_OPENAI_API_KEY=xxx
AZURE_OPENAI_ENDPOINT=https://xxx.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# ========================================
# POWER BI (Optionnel)
# ========================================
POWERBI_CLIENT_ID=xxx
POWERBI_CLIENT_SECRET=xxx
POWERBI_TENANT_ID=xxx
POWERBI_WORKSPACE_ID=xxx

# ========================================
# EMAIL (Optionnel)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@powalyze.com
SMTP_PASSWORD=xxx
SMTP_FROM=noreply@powalyze.com

# ========================================
# MODE DÉVELOPPEMENT
# ========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
